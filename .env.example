# Cookbook provider mode. Use mock for no-key local demos.
AHC_PROVIDER=mock

# Use this when AHC_PROVIDER=litellm.
# Examples:
#   openai/gpt-4o-mini
#   anthropic/claude-3-5-haiku-latest
#   nvidia_nim/meta/llama-3.1-70b-instruct
AHC_MODEL=openai/gpt-4o-mini

# Add one or more real provider keys if you want LiteLLM proxy routing.
OPENAI_API_KEY=

ANTHROPIC_API_KEY=

NVIDIA_API_KEY=
