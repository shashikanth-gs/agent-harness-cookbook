# Cookbook provider mode. Use mock for no-key local demos.
# Supported modes:
#   mock
#   litellm
#   nvidia_direct
AHC_PROVIDER=mock

# Use this when AHC_PROVIDER=litellm.
# Examples:
#   openai/gpt-4o-mini
#   anthropic/claude-3-5-haiku-latest
#   nvidia_nim/mistralai/mistral-medium-3.5-128b  # demo only; choose your own model
AHC_MODEL=openai/gpt-4o-mini
AHC_CHAT_MODEL=nvidia_nim/mistralai/mistral-small-4-119b-2603
AHC_EMBEDDING_MODEL=nvidia_nim/nvidia/nv-embedqa-e5-v5
AHC_RERANK_MODEL=nvidia/llama-nemotron-rerank-1b-v2
AHC_RERANK_PROVIDER=mock
AHC_JUDGE_MODEL=nvidia_nim/mistralai/mistral-small-4-119b-2603
AHC_LITELLM_DROP_PARAMS=true
AHC_MAX_TOKENS=512
AHC_TEMPERATURE=0.10
AHC_TOP_P=1.00

# Add one or more real provider keys if you want LiteLLM SDK routing.
OPENAI_API_KEY=

ANTHROPIC_API_KEY=

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1

# Use these for AHC_PROVIDER=nvidia_direct.
# This path calls NVIDIA's OpenAI-compatible chat-completions endpoint directly.
NVIDIA_API_KEY=
NVIDIA_NIM_INVOKE_URL=https://integrate.api.nvidia.com/v1/chat/completions
